# Copy this file to .env for local development and fill in values.
# .env is ignored by git. Never put real values in this file.
# Where each value lives: config/secrets-inventory.md

ENVIRONMENT=local
LOG_LEVEL=INFO

# Google Cloud / Vertex AI (no API key: local runs use your gcloud login, Cloud Run uses its service account)
GCP_PROJECT_ID=wellmate-i
GCP_REGION=us-central1
MODEL_REGION=us-east5
CHAT_PROVIDER=claude
CHAT_MODEL=claude-sonnet-5-5
BACKGROUND_PROVIDER=claude
BACKGROUND_MODEL=claude-haiku-5-5

# Firebase Auth
FIREBASE_PROJECT_ID=wellmate-i
# true only on your own machine, to skip sign-in while testing
AUTH_DISABLED=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Tool keys (fill in as each tool gets built)
NCBI_API_KEY=
WEB_SEARCH_API_KEY=
GOOGLE_PLACES_API_KEY=

# Embeddings (vector size must match the database column)
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSIONS=768

# Conversation behavior. Chat also needs a crisis screen registered in safety/__init__.py.
CHAT_ENABLED=false
MAX_OUTPUT_TOKENS=1500
MAX_TOOL_ROUNDS=5
HISTORY_MESSAGES=30
SUMMARY_COUNT=3
IDLE_MINUTES_BEFORE_CLOSE=30

# USD per million tokens, from the Vertex AI pricing page. Leave {} until filled in.
MODEL_PRICES={}

# Background jobs: the engine's Cloud Run URL and the service account Cloud Scheduler uses
JOB_AUDIENCE=
JOB_INVOKER_EMAIL=

# Optional: allow Lovable preview hosts, e.g. https://.*\.lovable\.app
ALLOWED_ORIGIN_REGEX=
